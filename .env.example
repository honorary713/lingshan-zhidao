# 复制本文件为 .env 后填写（放在项目根目录即可，backend/.env 亦可，后者优先级更高）
# 未填写的项请直接留空，不要保留 your_xxx 占位串

# ===== LLM 对话大模型（必需）=====
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ===== Embedding 向量模型（必需）=====
# 推荐 qwen3.7-text-embedding（201 语种）或 text-embedding-v4（Qwen3-Embedding 系列）
# 与下面的 DASHSCOPE_API_KEY 可以只填一个，两边共用阿里云百炼的同一个 Key
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=qwen3.7-text-embedding

# ===== 阿里云百炼 DashScope（可选，语音/多模态）=====
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
TTS_MODEL=cosyvoice-v1
TTS_VOICE=longxiaochun
VL_MODEL=qwen-vl-max

# ===== 阿里云智能语音交互 NLS（可选）=====
# 不填则自动降级到免费的 edge-tts（无需任何 Key 即可发声）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALI_TTS_APPKEY=

# ===== 百度语音技术（可选，应用级 Key：ASR 语音识别 + TTS 语音合成共用）=====
# TTS 走百度精品/臻品音库，音色在后台「数字人配置 → 语音参数」里选（存 per 编号）
# 不填则麦克风不可用，且 TTS 降级到免费的 edge-tts
BAIDU_ASR_API_KEY=
BAIDU_ASR_SECRET_KEY=

# ===== 后台默认管理员（本地开发用）=====
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me
